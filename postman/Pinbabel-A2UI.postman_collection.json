                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"a2a-x-submit\",\n  \"method\": \"message/send\",\n  \"params\": {\n    \"message\": {\n      \"kind\": \"message\",\n      \"role\": \"user\",\n      \"messageId\": \"postman-x-message-1\",\n      \"parts\": [\n        {\n          \"kind\": \"data\",\n          \"data\": {\n            \"operation\": \"analyzeRecentXCompanies\",\n            \"account\": \"{{xAccount}}\"\n          }\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
