                  "pm.test('요청한 A2A Task ID와 일치한다', () => pm.expect(response.result.id).to.eql(pm.collectionVariables.get('a2aRecentXTaskId')));",
                  "pm.test('Task 상태가 존재한다', () => pm.expect(response.result.status.state).to.be.a('string').and.not.empty);",
                  "console.log('A2A Recent X state:', response.result.status.state, 'artifacts:', response.result.artifacts || []);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"a2a-x-query\",\n  \"method\": \"tasks/get\",\n  \"params\": {\n    \"id\": \"{{a2aRecentXTaskId}}\",\n    \"historyLength\": 0\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/a2a",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "a2a"
