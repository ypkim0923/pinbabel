          }
        }
      ]
    },
    {
      "name": "5. A2UI 오류 계약",
      "description": "외부 호출 없이 validation과 조회 오류 계약을 확인합니다.",
      "item": [
        {
          "name": "빈 instruction 거절",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request를 반환한다', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/x-ndjson, application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instruction\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/a2ui/v0.9/analyses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "a2ui",
                "v0.9",
                "analyses"
              ]
            }
          }
        },
        {
